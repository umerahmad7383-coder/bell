{
  "name": "the-last-bell",
  "version": "0.1.0",
  "description": "THE LAST BELL - online co-op horror game (Three.js + Rapier + Socket.IO)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "vendor": "node scripts/vendor.js",
    "test": "node test/smoke.js && node test/ai.js && node test/physics.js",
    "test:browser": "node test/browser-e2e.js",
    "map": "node scripts/map.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "socket.io-client": "^4.8.1",
    "three": "^0.170.0"
  }
}
